# Kommagetrennte Liste der Kinder, die auf der Spülmaschinen-Seite abwechselnd dran sind
NEXT_PUBLIC_DISHWASHER_KIDS=Kind1,Kind2

# IP/Hostname des Familyboard-Servers im lokalen Netz, damit die /mypage-Seite
# vom Handy aus den Socket-Server (Port 3009) auf dem Familyboard erreicht
NEXT_PUBLIC_FAMILYBOARD_HOST=192.1.1.1
